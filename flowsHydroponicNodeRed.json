        "name": "setDataNodeMCUB",
        "func": "let data, arrData, dataSplit;\n// mengambil data dari topik dataPPFDHumidity\"\nif (msg.topic == \"dataPPFDHumidity\") {\n    data = msg.payload\n}\n\nif(data != undefined)\n{\n    dataSplit = data.split(\"|\")\n    // Cek apakah data yang diterima lengkap\n    if (dataSplit.length == 2) {\n        // Menyimpan data dalam array\n        arrData = {\n            'PAR': dataSplit[0],\n            'kelembaban': dataSplit[1],\n            // 'systemControl': context.get('systemController'),\n        }\n        /* \n            Menyimpan array dalam penyimpanan sementara dengan tipe flow\n            Digunakan flow karena datanya akan digunakan pada node yang tidak terhubung dengan node ini namum masih dalam 1 flow\n         */\n        flow.set('dataNodeMCUB', arrData);\n    }\n}\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "// Code added here will be run once\n// whenever the node is started.\nflow.set('dummyPPFD', 400);",
        "finalize": "",
        "libs": [],
        "x": 310,
        "y": 2060,
        "wires": [
