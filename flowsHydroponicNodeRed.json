    {
        "id": "8eaa3c5b50ffa4f6",
        "type": "function",
        "z": "95838420939a3044",
        "name": "Hidroponik",
        "func": "let\n    result,\n    data,\n    ppfd,\n    prediction,\n    dataGambar,\n    arrDataRaspi,\n    tableData,\n    arrDataNodeMCUA,\n    arrDataNodeMCUB,\n    maxConfidence,\n    dummyPH\n\narrDataNodeMCUA = flow.get('dataNodeMCUA');\narrDataNodeMCUB = flow.get('dataNodeMCUB');\narrDataRaspi = flow.get('dataRaspi');\ndataGambar = flow.get('dataGambar');\ntableData = flow.get('dataTable') || [];\nmaxConfidence = Math.max(...arrDataRaspi.confidence);\nppfd = getPPFD();\ndummyPH = getPH();\nprediction = getLabelPrediction();\ntableData = mappingData(tableData, arrDataNodeMCUA, arrDataNodeMCUB, prediction );\nresult = [\n    { payload: arrDataNodeMCUA.tds },\n    { payload: arrDataNodeMCUA.temperatur },\n    { \n        payload: arrDataNodeMCUA.waterLevelA,\n        status: arrDataNodeMCUA.waterLevelA == 1 ? \"Tersedia\" : \"Habis\",\n        color: arrDataNodeMCUA.waterLevelA == 1 ? \"#06912b\" : \"#910606\"\n    },\n    {\n        payload: arrDataNodeMCUA.waterLevelB,\n        status: arrDataNodeMCUA.waterLevelB == 1 ? \"Tersedia\" : \"Habis\",\n        color: arrDataNodeMCUA.waterLevelB == 1 ? \"#06912b\" : \"#910606\"\n    },\n    { payload: arrDataNodeMCUA.pH }, //arrDataNodeMCUA.pH\n    { payload: arrDataNodeMCUB.PAR },\n    { payload: prediction },\n    { payload: maxConfidence},\n    { payload: arrDataRaspi.waktu },\n    { payload: dataGambar },\n    { payload: arrDataNodeMCUB.kelembaban },\n    { payload : tableData},\n    { payload : saveToDb(arrDataNodeMCUA,arrDataNodeMCUB,prediction)}\n];\n\n// menyimpan isi dari tabel pada flow dengan key dataTable\nflow.set('dataTable', tableData);\n\n// reset tabel jika datanya lebih dari atau sama dengan 200\nif (tableData.length >= 100) {\n    flow.set('dataTable', null);\n}\n\nreturn result;\n\nfunction getPPFD() {\n    let dummyPPFD = flow.get('dummyPPFD')\n    let randomNumber = Math.floor(Math.random() * (3)) - 2;\n    return dummyPPFD + randomNumber\n}\n\nfunction getPH() {\n    let dummyPh = 7\n    let randomNumber = (Math.random() - 0.3);\n    let result = dummyPh + randomNumber;\n    return parseFloat(result.toFixed(2));\n}\n\nfunction getLabelPrediction() {\n    let prediction = arrDataRaspi.prediksi;\n    let label = \"\";\n    switch (prediction) {\n        case 0:\n            label = \"Tahap Vegetatif Awal\";\n            break;\n        case 1:\n            label = \"Tahap Vegetatif Akhir\";\n            break;\n        case 2:\n            label = \"Siap Panen\";\n            break;\n        default:\n            label = \"Tanaman Tidak Terdeteksi\";\n            break;\n    }\n    return label;\n}\n\n/**\n* @param {{nutrientTemperature: any;plantTemperature: any;tds: any;minTDS: any;maxTDS: any;ph: any;nutrient: string;fertilizer: string;pumpControl: string;fertilizerPump: string;nutrientPump: string;datetime: any;}[]} tableData\n* @param {any} arrDataNodeMCUA\n* @param {any} arrDataNodeMCUB\n* @param {any} prediction\n*/\nfunction mappingData(tableData, arrDataNodeMCUA, arrDataNodeMCUB,prediction) {\n    tableData.unshift({\n        \"prediksi\" : prediction,\n        \"par\" : arrDataNodeMCUB.PAR,\n        \"tds\": arrDataNodeMCUA.tds,\n        \"temperatur\": arrDataNodeMCUA.temperatur,\n        \"ph\": arrDataNodeMCUA.pH, //arrDataNodeMCUA.pH\n        \"pupukA\": arrDataNodeMCUA.waterLevelA == \"1\" ? \"Tersedia\" : \"Habis\",\n        \"pupukB\": arrDataNodeMCUA.waterLevelB == \"1\" ? \"Tersedia\" : \"Habis\",\n        \"pompa\": arrDataNodeMCUA.pompa == \"1\"? \"Tidak Aktif\" : \"Tidak Aktif\",\n        \"kelembapan\": arrDataNodeMCUB.kelembaban, //arrDataNodeMCUB.kelembaban\n        \"datetime\": getDate(),\n    })\n    return tableData\n}\n\n// fungsi untuk mengambil tanggal dan waktu saat ini\nfunction getDate() {\n    // Ambil waktu sekarang\n    var date = new Date();\n    // set timezone GMT+8\n    date.setUTCHours(date.getUTCHours() + 8);\n    // Array untuk menyimpan nama bulan\n    var monthNames = [\n        'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',\n        'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'\n    ];\n\n    // Dapatkan tanggal, bulan, tahun, jam, dan menit dari objek Date\n    var day = date.getDate();\n    var monthIndex = date.getMonth();\n    var year = date.getFullYear();\n    var hours = date.getHours();\n    var minutes = date.getMinutes();\n\n    // ubah format jam menjadi 2 karakter\n    hours = String(hours).padStart(2, '0');\n    // ubah format menit menjadi 2 karakter\n    minutes = String(minutes).padStart(2, '0');\n\n    // Ubah format tanggal dan waktu menjadi seperti '1 Januari 2020 23:20'\n    var formattedDate = day + ' ' + monthNames[monthIndex] + ' ' + year + ' ' + hours + ':' + minutes;\n\n    return formattedDate;\n}\n\n/**\n* @param {{ temperatur: string; tds: string; pH: string; waterLevelA: string; waterLevelB: string; pompa: string; }} arrDataNodeMCUA\n* @param {{ kelembaban: string; PAR: string }} arrDataNodeMCUB\n* @param {any} prediction\n*/\nfunction saveToDb(arrDataNodeMCUA, arrDataNodeMCUB, prediction) {\n    var date = new Date();\n    // set timezone GMT+8\n    date.setUTCHours(date.getUTCHours() + 8);\n    data = {\n        \"prediksi\": prediction,\n        \"kelembapan\": parseFloat(arrDataNodeMCUB.kelembaban),\n        \"temperatur\": parseFloat(arrDataNodeMCUA.temperatur),\n        \"par\": parseFloat(arrDataNodeMCUB.PAR),\n        \"tds\": parseFloat(arrDataNodeMCUA.tds),\n        \"ph\": parseFloat(arrDataNodeMCUA.pH),\n        \"pupukA\": parseInt(arrDataNodeMCUA.waterLevelA),\n        \"pupukB\": parseInt(arrDataNodeMCUA.waterLevelB),\n        \"pompa\": parseInt(arrDataNodeMCUA.pompa),\n        \"created_at\": date,\n        \"updated_at\": date,\n    }\n    return data;\n}",
