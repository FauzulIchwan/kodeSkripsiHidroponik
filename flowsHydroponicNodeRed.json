    {
        "id": "569583e2d509c248",
        "type": "function",
        "z": "95838420939a3044",
        "name": "setThresholdLight",
        "func": "let kelas,minThreshold,maxThreshold;\nkelas = flow.get('dataPrediction').prediksi;\n\nswitch (kelas) {\n    case 1: // Vegetatif\n        minThreshold = 200;\n        maxThreshold = 300;\n        break;\n    case 2: // Generatif\n        minThreshold = 300;\n        maxThreshold = 500;\n        break;\n    case 3: // Siap Panen\n        minThreshold = 500;\n        maxThreshold = 600;\n        break;\n    default:\n        minThreshold = 300;\n        maxThreshold = 500; // Default threshold jika kelas tidak dikenali\n        break;\n}\nmsg.payload = JSON.stringify({ minThreshold: minThreshold , maxThreshold: maxThreshold });\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
