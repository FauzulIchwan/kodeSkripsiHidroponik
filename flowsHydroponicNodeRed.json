        "type": "function",
        "z": "95838420939a3044",
        "name": "Interval ",
        "func": "let newDate = new Date();\n// @ts-ignore\n\n// Mneghitung selisih waktu yang diset pada On Start (setDateSaveDb) dengan waktu saat ini\nlet diffMinute = (newDate - context.get('setDateStartDb')) / (1000 * 60);\n\n// cek jika selisih waktu lebih dari 15 menit\nif (diffMinute > 15) {\n    // menimpa waktu yang diset dengan waktu saat ini\n    context.set('setDateStartDb', new Date())\n    // return data yang akan disave ke db\n    return msg;\n}",
        "outputs": 1,
        "noerr": 0,
        "initialize": "// Code added here will be run once\n// whenever the node is started.\ncontext.set('setDateStartDb', new Date('2025-01-18T17:00:00'));",
