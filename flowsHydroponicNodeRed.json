        "type": "function",
        "z": "95838420939a3044",
        "name": "setDataRaspi",
        "func": "let data, arrData;\n\n// Mengambil data dari topik \"dataRaspi\"\nif (msg.topic === \"dataRaspi\") {\n    data = msg.payload;\n}\n\n// Pastikan data tidak undefined\nif (data !== undefined) {\n    // Jika data berbentuk string JSON, parse menjadi objek\n    try {\n        let parsedData = typeof data === \"string\" ? JSON.parse(data) : data;\n\n        // Cek apakah data memiliki semua properti yang dibutuhkan\n        if (parsedData.hasOwnProperty('prediction') && parsedData.hasOwnProperty('timestamp')) {\n            // Menyimpan data ke dalam array/objek\n            arrData = {\n                'prediksi': parsedData.prediction,\n                'waktu': parsedData.timestamp,\n                'confidence' : parsedData.confidence\n            };\n\n            // Menyimpan array ke dalam penyimpanan flow\n            flow.set('dataRaspi', arrData);\n        }\n    } catch (err) {\n        // Log jika parsing JSON gagal\n        node.error(\"Gagal parsing JSON data: \" + err.message);\n    }\n}\n\nreturn msg;",
