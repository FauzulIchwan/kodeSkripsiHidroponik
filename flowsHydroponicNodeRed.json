    {
        "id": "b3b49d3bb80e408a",
        "type": "function",
        "z": "95838420939a3044",
        "name": "setDataNodeMCUA",
        "func": "let data, arrData, dataSplit;\n\nif (msg.topic == \"dataNodeMCUA\") {\n    data = msg.payload\n}\n\nif(data != undefined)\n{\n    dataSplit = data.split(\"|\")\n    // Cek apakah data yang diterima lengkap\n    if (dataSplit.length == 6) {\n        // Menyimpan data dalam array\n        arrData = {\n            'tds': dataSplit[0],\n            'temperatur': dataSplit[1],\n            'waterLevelA':dataSplit[2],\n            'waterLevelB': dataSplit[3],\n            'pH': dataSplit[4],\n            'pompa': dataSplit[5]\n        }\n        flow.set('dataNodeMCUA', arrData);\n    }\n}\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "// Code added here will be run once\n// whenever the node is started.\nflow.set('dummyPPFD', 400);",
        "finalize": "",
        "libs": [],
        "x": 310,
        "y": 1760,
        "wires": [
            []
        ]
